---
import Layout from '@/layouts/Layout.astro';
import Toast from '@/components/toast.astro';
import { getGameBySlug } from '@/services/games';

const [game, error] = await getGameBySlug('chrono-cross', Astro.url.origin);

if (!game) {
  return Astro.redirect('/404');
}
---

<Layout 
  title="Testing" 
  description="Testing">
  
  <section class="p-4 pt-20" data-game-id={game.id}>
    <!--
    <pre>{JSON.stringify(
      game.guides.map((g) => ({
        ...g,
        adventures: g.adventures.map(({ images, ...a }) => a),
      })),
      null,
      2
    )}</pre>

    <h2 class="mt-8 font-bold">Progreso (user-guides por game)</h2>
    <pre id="progress-out">Cargando...</pre>
    -->

    <div class=" flex gap-4 p-4 text-error">
      <div class="flex gap-2">
        <span class="loading loading-spinner text-error"></span>
        loading user guide...
      </div>
      <div class="flex gap-2">
        <span class="loading loading-spinner text-error"></span>
        loading user adventure... 
      </div>
    </div>

    {
      game.guides.map((gui) => (
        <section class="grid mb-4">
          <div class="flex gap-4 text-primary">
            <div class="tooltip tooltip-top tooltip-start" data-tip="Debes Iniciar Sesion">
              <input type="checkbox" data-guide-id={gui.id} />
            </div>
            <p>[Guide {gui.id}] {gui.title}</p>
          </div>
          <div class="pl-20 text-warning">
            {
              gui.adventures.map((adv) => (
                <div class="flex gap-4">
                  <div class="tooltip tooltip-top tooltip-start" data-tip="Debes Iniciar Sesion">
                    <input type="checkbox" data-adventure-id={adv.id} />
                  </div>
                  <p>[Adventure Id: {adv.id}]</p>
                  <span class="text-accent">islogged</span>
                </div>
              ))
            }
          </div>
        </section>
      ))
    }
  </section>

  {
    error && <Toast message={error} type="error" />
  }
</Layout>

<script>
  import { getAccessToken, isAuthenticated } from '@/lib/auth';
  import { showToast } from '@/lib/toast';

  export interface GuideCheck { guide_id: number; }
  export interface AdventureCheck { adventure_id: number; }

  type HttpMethod = 'GET' | 'POST' | 'DELETE';
  type RequestBody = GuideCheck | AdventureCheck;

  const allTooltips = document.querySelectorAll<HTMLElement>('[data-tip]');
  const allGuides = document.querySelectorAll<HTMLInputElement>('[data-guide-id]');
  const allAdventure = document.querySelectorAll<HTMLInputElement>('[data-adventure-id]');
  const containerComponent = document.querySelector<HTMLElement>('[data-game-id]');
  const gameId = Number(containerComponent?.getAttribute('data-game-id'));

  containerComponent?.addEventListener('change', async (e) => {
    const checkbox = e.target as HTMLInputElement;
    if (checkbox.matches('[data-guide-id]')) await toggleGuide(checkbox);
    if (checkbox.matches('[data-adventure-id]')) await toggleAdventure(checkbox);
  });

  async function toggleGuide(cb: HTMLInputElement) {
    const guideId = Number(cb.dataset.guideId);
    const checked = cb.checked;
    const result = await fetchProgress(
      checked ? 'user-guides' : `user-guides/${guideId}`,
      checked ? 'POST' : 'DELETE',
      checked ? { guide_id: guideId } : undefined
    );
    if (result === null) cb.checked = !checked;
  }

  async function toggleAdventure(cb: HTMLInputElement) {
    const adventureId = Number(cb.dataset.adventureId);
    const checked = cb.checked;
    const result = await fetchProgress(
      checked ? 'user-adventures' : `user-adventures/${adventureId}`,
      checked ? 'POST' : 'DELETE',
      checked ? { adventure_id: adventureId } : undefined
    );
    if (result === null) cb.checked = !checked;
  }
  
  async function fetchProgress(path: string, method: HttpMethod = 'GET', body?: RequestBody) {
    const res = await fetch('/api/proxy/' + path, {
      method,
      headers: { 
        Authorization: 'Bearer ' + getAccessToken(), 
        ...(body && { 'Content-Type': 'application/json' }),
      },
      body: body ? JSON.stringify(body) : undefined,
    }); 
    
    if (!res.ok) {
      showToast(`Error al cargar progreso (${res.status})`, 'error');
      return null;
    }

    if (res.status === 204) return {}; 
    return await res.json();
  }

  async function getGuideProgress() {
    if (!isAuthenticated()) return [];
    return await fetchProgress(`user-guides/by-game/${gameId}`);
  }

  async function getAdventureProgress() {
    if (!isAuthenticated()) return [];
    return await fetchProgress(`user-adventures/by-game/${gameId}`);
  }

  // Se entera del logout (authchange) y actualiza la página sin recargar
  window.addEventListener('authchange', onAuthChange);

  async function onAuthChange() {
    console.log(await getGuideProgress())
    console.log(await getAdventureProgress())

    const authed = isAuthenticated();
    showToast(`authchange → isAuthenticated: (${authed})`, 'warning');
    allGuides.forEach((cb) => { cb.disabled = !authed; });
    allAdventure.forEach((cb) => { cb.disabled = !authed; });
    allTooltips.forEach((t) => { authed ? t.removeAttribute('data-tip') : t.setAttribute('data-tip', 'Debes Iniciar Sesion') });
  }

  onAuthChange();
</script>