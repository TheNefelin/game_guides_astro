---
import Layout from '@/layouts/Layout.astro';

const reasons = [
  { value: 'colaborar', label: 'Colaborar con una guía' },
  { value: 'reclamo', label: 'Reclamo' },
  { value: 'sugerencia', label: 'Sugerencia' },
  { value: 'otros', label: 'Otros' },
];
---

<Layout title="Contacto - Game Guides" description="Contactate con Game Guides para colaborar con guías, hacer un reclamo o dejar tu sugerencia.">
  <section class="max-w-3xl mx-auto px-4 lg:px-8 pt-32">
    <div class="text-center mb-10">
      <h1 class="font-gaming text-3xl md:text-4xl font-bold text-base-content mb-3">
        Contacto
      </h1>
      <p class="text-gray-400 text-sm md:text-base">
        ¿Colaborar con una guía, un reclamo o simplemente saludar? Escribinos.
      </p>
    </div>
  </section>

  <section class="max-w-xl mx-auto px-4 py-8 my-8 bg-base-300 glass-card rounded-box ">
    <div class="absolute -z-10 inset-0 bg-linear-to-t from-base-100 to-base-300 rounded-box"></div>

    <header class="px-4">
      <h2 class="font-gaming text-lg font-bold text-base-content mb-2 flex items-center gap-2">
        <i class="fa-solid fa-paper-plane text-accent"></i>
        Enviar mensaje
      </h2>
      <p class="text-gray-400 text-sm mb-6">Completá el formulario y te responderemos al correo asociado a tu cuenta.</p>
    </header>

    <form id="contactForm" class="grid gap-2 p-2" novalidate>
      <fieldset class="fieldset">
        <header class="flex gap-2">
          <i class="fa-solid fa-tags text-base-content/30 text-sm"></i>
          <label for="reason" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider">Motivo</label>
        </header>
        <select id="reason" name="reason" class="select w-full" required>
          { reasons.map((r) => <option value={r.value}>{r.label}</option>) }
        </select>
      </fieldset>

      <fieldset class="fieldset">
        <header class="flex gap-2">
          <i class="fa-solid fa-user text-base-content/30 text-sm"></i>
          <label for="name" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider">Nombre</label>
        </header>
        <input type="text" id="name" name="name" class="input w-full" placeholder="Tu nombre" required />
      </fieldset>

      <fieldset class="fieldset">
        <header class="flex gap-2">
          <i class="fa-solid fa-envelope text-base-content/30 text-sm"></i>
          <label for="email" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider">Email</label>
        </header>
        <input type="email" id="email" name="email" class="input w-full" placeholder="tucorreo@ejemplo.com" readonly data-auth-email disabled />
      </fieldset>

      <fieldset class="fieldset">
        <header class="flex gap-2">
          <i class="fa-solid fa-envelope-open-text text-base-content/30 text-sm"></i>
          <label for="message" class="block text-xs font-semibold text-base-content/50 uppercase tracking-wider">Mensaje</label>
        </header>
        <textarea id="message" name="message" class="textarea h-36 w-full" placeholder="En qué podemos ayudarte..." required></textarea>
      </fieldset>

      <div class="tooltip tooltip-top tooltip-start w-full" data-tip="Debes Iniciar Sesion">
        <button type="submit" class="btn btn-accent w-full text-sm">
          <i class="fa-solid fa-paper-plane"></i>
          Enviar mensaje
        </button>
      </div>
    </form>
  </section>
</Layout>

<script>
  import { apiFetch, isAuthenticated, getUser } from '@/lib/auth';
  import { showToast } from '@/lib/toastTrigger';

  const form = document.getElementById('contactForm') as HTMLFormElement;
  const tooltip = form?.querySelector<HTMLElement>('.tooltip');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const reason = document.getElementById('reason') as HTMLSelectElement;
  const name = document.getElementById('name') as HTMLInputElement;
  const email = document.getElementById('email') as HTMLInputElement;
  const message = document.getElementById('message') as HTMLTextAreaElement;

  function updateUI() {
    const authed = isAuthenticated();
    const user = getUser();
    submitBtn?.classList.toggle('btn-disabled', !authed);
    email.disabled = !authed;
    if (authed && user?.email) email.value = user.email;
    else email.value = '';
    if (authed) tooltip?.removeAttribute('data-tip');
    else tooltip?.setAttribute('data-tip', 'Debes Iniciar Sesion');
  }

  window.addEventListener('authchange', updateUI);
  updateUI();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (!isAuthenticated()) {
      showToast('Debes Iniciar Sesión para enviar', 'warning');
      return;
    }

    submitBtn?.classList.add('btn-disabled');
    try {
      const res = await apiFetch('contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason.value, name: name.value, message: message.value }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        const detail = Array.isArray(err.detail)
          ? err.detail.map((e: { msg: string }) => e.msg).join(', ')
          : err.detail;
        showToast(detail || `Error al enviar el mensaje (${res.status})`, 'error');
        return;
      }

      showToast('Mensaje enviado correctamente', 'success');
      form.reset();
      updateUI();
    } catch {
      showToast('Error de red, revisa tu conexión', 'error');
    } finally {
      submitBtn?.classList.remove('btn-disabled');
    }
  });
</script>

