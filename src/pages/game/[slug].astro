---
import Layout from '@/layouts/Layout.astro';
import { getGameBySlug } from '@/services/games';
import Toast from '@/components/toast.astro';
import TagPill from '@/components/TagPill.astro';
import Stars from '@/components/Stars.astro';

const { slug } = Astro.params;
const [game, error] = await getGameBySlug(slug!, Astro.url.origin);

if (!game) {
  return Astro.redirect('/404');
}

const bgImage = 'https://res.cloudinary.com/dsvkbe0mc/image/upload/v1770860243/news/ruatveggaye123paqwbv.webp';
---

<Layout title={`${game.name} - Game Guide`} description={game.description ?? undefined}>
  {
    error && <Toast message={error} type="error" />
  }

  <!-- Hero -->
  <section class="relative min-h-[50vh] md:min-h-[60vh] flex items-end pt-16 bg-cover bg-center bg-fixed" style={`background-image: url('${bgImage}')`}>
    <div class="absolute inset-0 bg-linear-to-t from-base-100 via-base-100/20 to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full relative z-10 pb-8 md:pb-12">
      <div class="flex flex-col md:flex-row md:items-end gap-6">
        <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl overflow-hidden shadow-2xl border-2 border-primary/20 shrink-0 bg-base-300">
          {
            game.cover_url
              ? <img src={game.cover_url} alt={game.name} class="w-full h-full object-cover" />
              : <div class="w-full h-full flex items-center justify-center text-base-content/20 text-4xl"><i class="fa-solid fa-gamepad"></i></div>
          }
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            {
              game.platforms.map(p => <TagPill text={p.name} />)
            }
            {
              game.genres.map(g => <TagPill text={g.name} />)
            }
          </div>
          <h1 class="font-gaming text-3xl md:text-5xl font-black text-base-content neon-text">{game.name}</h1>
          <div class="flex items-center gap-4 mt-2 text-base-content/50 text-sm">
            {
              game.release_year && (
                <span><i class="fa-solid fa-calendar mr-1"></i> {game.release_year}</span>
              )
            }
            <Stars rating={game.rating} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabs -->
  <section class="max-w-7xl mx-auto px-4 lg:px-8 py-6">
    <div class="glass-card rounded-xl p-2 flex flex-wrap gap-2">
      <button class="tab-btn active" data-tab="guide">
        <i class="fa-solid fa-book-open mr-2"></i>Juego
      </button>
      <button class="tab-btn" data-tab="timeline">
        <i class="fa-solid fa-timeline mr-2"></i>Guía Time Line
      </button>
      <button class="tab-btn" data-tab="maps">
        <i class="fa-solid fa-map mr-2"></i>Mapas
      </button>
      <button class="tab-btn" data-tab="characters">
        <i class="fa-solid fa-users mr-2"></i>Personajes
      </button>
      <button class="tab-btn" data-tab="sources">
        <i class="fa-solid fa-link mr-2"></i>Fuentes
      </button>
    </div>
  </section>

  <!-- Main Content -->
  <section class="max-w-7xl mx-auto px-4 lg:px-8 pb-24">

    <!-- TAB: Juego -->
    <div class="tab-content active" id="tab-guide">
      <div class="glass-card rounded-xl p-6 md:p-8 mb-8">
        <p class="text-base-content/60 leading-relaxed text-lg indent-8">
          {game.description ?? 'Sin descripción disponible.'}
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-xl overflow-hidden shadow-xl border border-base-content/10">
          <img src={bgImage} alt={`${game.name} screenshot 1`} class="w-full h-auto object-cover" />
        </div>
        <div class="rounded-xl overflow-hidden shadow-xl border border-base-content/10">
          <img src={bgImage} alt={`${game.name} screenshot 2`} class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>

    <!-- TAB: Time Line -->
    <div class="tab-content" id="tab-timeline">
      <div class="glass-card rounded-xl p-6 md:p-8">
        <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
          <div>
            <h2 class="font-gaming text-2xl font-bold text-base-content">
              <i class="fa-solid fa-timeline text-primary mr-3"></i>Guía Time Line
            </h2>
            <p class="text-base-content/40 text-sm mt-1">Sigue la aventura paso a paso</p>
          </div>
        </div>
        <div class="text-center py-12 text-base-content/30">
          <i class="fa-solid fa-timeline text-4xl mb-4 block"></i>
          <p>Las entradas de la guía se cargarán próximamente.</p>
        </div>
      </div>
    </div>

    <!-- TAB: Mapas -->
    <div class="tab-content" id="tab-maps">
      <div class="glass-card rounded-xl p-6 md:p-8">
        <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
          <div>
            <h2 class="font-gaming text-2xl font-bold text-base-content">
              <i class="fa-solid fa-map text-primary mr-3"></i>Mapas
            </h2>
            <p class="text-base-content/40 text-sm mt-1">Mapas y zonas del juego</p>
          </div>
        </div>
        <div class="text-center py-12 text-base-content/30">
          <i class="fa-solid fa-map text-4xl mb-4 block"></i>
          <p>Los mapas se cargarán próximamente.</p>
        </div>
      </div>
    </div>

    <!-- TAB: Personajes -->
    <div class="tab-content" id="tab-characters">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-gaming text-2xl font-bold text-base-content">
            <i class="fa-solid fa-users text-primary mr-3"></i>Personajes
          </h2>
          <p class="text-base-content/40 text-sm mt-1">Personajes del juego</p>
        </div>
      </div>
      <div class="text-center py-12 text-base-content/30">
        <i class="fa-solid fa-users text-4xl mb-4 block"></i>
        <p>Los personajes se cargarán próximamente.</p>
      </div>
    </div>

    <!-- TAB: Fuentes -->
    <div class="tab-content" id="tab-sources">
      <div class="glass-card rounded-xl p-6 md:p-8">
        <h2 class="font-gaming text-2xl font-bold text-base-content mb-6">
          <i class="fa-solid fa-link text-primary mr-3"></i>Fuentes y Referencias
        </h2>
        <div class="text-center py-12 text-base-content/30">
          <i class="fa-solid fa-link text-4xl mb-4 block"></i>
          <p>Las fuentes se cargarán próximamente.</p>
        </div>
      </div>
    </div>

  </section>
</Layout>

<style is:global>
  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .tab-btn {
    position: relative;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.3s;
    color: var(--color-base-content);
    opacity: 0.5;
    background: transparent;
    border: 1px solid transparent;
  }
  .tab-btn:hover {
    opacity: 1;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }
  .tab-btn.active {
    opacity: 1;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 20%, transparent);
  }
</style>

<script>
  const doc = document!;
  doc.querySelectorAll<HTMLElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      doc.querySelectorAll<HTMLElement>('.tab-btn').forEach(b => b.classList.remove('active'));
      doc.querySelectorAll<HTMLElement>('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      doc.getElementById('tab-' + btn.dataset.tab)?.classList.add('active');
    });
  });
</script>
