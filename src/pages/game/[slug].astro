---
import Layout from '@/layouts/Layout.astro';
import Toast from '@/components/toast.astro';
import GameHero from '@/components/Game/GameHero.astro';
import GameTabs from '@/components/Game/GameTabs.astro';
import { getGameBySlug } from '@/services/games';
const bottomless = '/images/sin_guia.gif';

const { slug } = Astro.params;
const [game, error] = await getGameBySlug(slug!, Astro.url.origin);

if (!game) {
  return Astro.redirect('/404');
}

const bgImage: string = game.screenshots?.[0]?.image_url ?? bottomless;
---

<Layout title={`${game.name} - Game Guide`} description={game.description ?? undefined}>
  <GameHero game={game} bgImage={bgImage} />

  <GameTabs game={game} screenshots={game.screenshots ?? []} maps={game.maps ?? []} />

  {
    error && <Toast message={error} type="error" />
  }
</Layout>
