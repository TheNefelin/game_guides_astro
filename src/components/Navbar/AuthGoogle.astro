---
import googleIcon from '@/assets/images/google.svg';
import mewtwoFallback from '@/assets/images/mewtwo.png';
---

<div class="flex items-center">
  <div id="auth-login">
    <button id="googleLoginBtn"
            class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed">
      <img src={googleIcon.src} alt="Google" class="w-5 h-5" />
      <span id="loginBtnText">Iniciar sesión</span>
    </button>
  </div>

  <div id="auth-user" class="hidden dropdown dropdown-end">
    <div tabindex="0" role="button" id="avatarBtn">
      <img id="userAvatar" class="w-8 h-8 rounded-full ring-2 ring-transparent hover:ring-emerald-400 transition-all"
           onerror={`this.onerror=null;this.src='${mewtwoFallback.src}';`} />
    </div>
    <div tabindex="0" class="dropdown-content mt-2 w-48 rounded-xl py-2 z-50"
        style="background: #15151f; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);">
      <div class="px-4 py-2 text-sm text-white font-medium truncate" id="userName"></div>
      <div class="px-4 py-1 text-xs text-gray-500 truncate" id="userEmail"></div>
      <hr class="my-2 border-white/5" />
      <button id="logoutBtn" class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-red-400 hover:bg-white/5 transition-colors">
        Cerrar sesión
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('access_token')) {
        var login = document.getElementById('auth-login');
        var userSection = document.getElementById('auth-user');
        if (login) login.classList.add('hidden');
        if (userSection) userSection.classList.remove('hidden');

        var rawUser = localStorage.getItem('user');
        var user = rawUser ? JSON.parse(rawUser) : null;
        if (user) {
          var avatar = document.getElementById('userAvatar');
          if (avatar && user.picture) avatar.src = user.picture;
          var name = document.getElementById('userName');
          if (name) name.textContent = user.name || '';
          var email = document.getElementById('userEmail');
          if (email) email.textContent = user.email || '';
        }
      }
    } catch (e) {}
  })();
</script>

<script>
  import { initAuthUI } from '@/lib/auth-ui';
  import mewtwoFallback from '@/assets/images/mewtwo.png';

  initAuthUI({
    loginSection: document.getElementById('auth-login')!,
    userSection: document.getElementById('auth-user')!,
    loginBtn: document.getElementById('googleLoginBtn') as HTMLButtonElement,
    loginBtnText: document.getElementById('loginBtnText') as HTMLSpanElement,
    logoutBtn: document.getElementById('logoutBtn') as HTMLButtonElement,
    avatar: document.getElementById('userAvatar') as HTMLImageElement,
    name: document.getElementById('userName')!,
    email: document.getElementById('userEmail')!,
    fallbackAvatar: mewtwoFallback.src,
  });
</script>
