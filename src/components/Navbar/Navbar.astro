---
import logo from '@/assets/images/logo.png';
import googleIcon from '@/assets/images/google.svg';
import mewtwoFallback from '@/assets/images/mewtwo.png';
import NavThemeToggle from './NavThemeToggle.astro';
import NavLinks from './NavLinks.astro';
import AuthGoogle from './AuthGoogle.astro';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/contacto', label: 'Contacto' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 px-4 lg:px-8 border-b border-white/5"
     style="background: rgba(10, 10, 15, 0.8); backdrop-filter: blur(20px);">
  <div class="max-w-7xl mx-auto flex items-center justify-between h-16">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <img src={logo.src} alt="Game Guides" class="w-10 h-10 object-contain" />
        <span class="font-gaming text-lg font-bold tracking-wider text-white block">
          Game<span class="text-emerald-400">Guides</span>
        </span>
      </a>
      <NavThemeToggle />
    </div>

    <NavLinks links={navLinks} />

    <div class="flex items-center gap-3">
      <AuthGoogle />

      <label for="mobileDrawer" class="text-gray-300 hover:text-emerald-400 md:hidden cursor-pointer">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </label>
    </div>
  </div>
</nav>

<div class="drawer drawer-end z-40">
  <input id="mobileDrawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-side">
    <label for="mobileDrawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="flex flex-col min-h-full w-64 p-4 pt-20 border-l border-white/5"
         style="background: rgba(10, 10, 15, 0.97); backdrop-filter: blur(20px);">
      {
        navLinks.map((link) => (
          <a href={link.href}
             class="block py-3 text-gray-300 hover:text-emerald-400 transition-colors text-sm font-medium"
             onclick="document.getElementById('mobileDrawer').checked = false">
            {link.label}
          </a>
        ))
      }

      <div class="mt-4 pt-4 border-t border-white/5">
        <div id="mobile-auth-login">
          <button id="mobileGoogleLoginBtn"
                  class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all text-sm font-medium w-full disabled:opacity-50 disabled:cursor-not-allowed">
            <img src={googleIcon.src} alt="Google" class="w-5 h-5" />
            <span id="mobileLoginBtnText">Iniciar sesión</span>
          </button>
        </div>
        <div id="mobile-auth-user" class="hidden">
          <div class="flex items-center gap-3 px-1 py-2">
            <img id="mobileUserAvatar" class="w-9 h-9 rounded-full ring-2 ring-emerald-400/40"
                 onerror={`this.onerror=null;this.src='${mewtwoFallback.src}';`} />
            <div class="min-w-0">
              <div class="text-white text-sm font-medium truncate" id="mobileUserName"></div>
              <div class="text-gray-500 text-xs truncate" id="mobileUserEmail"></div>
            </div>
          </div>
          <button id="mobileLogoutBtn" class="w-full text-left px-4 py-2 text-sm text-gray-300 hover:text-red-400 hover:bg-white/5 transition-colors rounded-lg mt-1">
            Cerrar sesión
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      if (localStorage.getItem('access_token')) {
        var login = document.getElementById('mobile-auth-login');
        var userSection = document.getElementById('mobile-auth-user');
        if (login) login.classList.add('hidden');
        if (userSection) userSection.classList.remove('hidden');

        var rawUser = localStorage.getItem('user');
        var user = rawUser ? JSON.parse(rawUser) : null;
        if (user) {
          var avatar = document.getElementById('mobileUserAvatar');
          if (avatar && user.picture) avatar.src = user.picture;
          var name = document.getElementById('mobileUserName');
          if (name) name.textContent = user.name || '';
          var email = document.getElementById('mobileUserEmail');
          if (email) email.textContent = user.email || '';
        }
      }
    } catch (e) {}
  })();
</script>

<script>
  import { initAuthUI } from '@/lib/auth-ui';

  initAuthUI({
    loginSection: document.getElementById('mobile-auth-login')!,
    userSection: document.getElementById('mobile-auth-user')!,
    loginBtn: document.getElementById('mobileGoogleLoginBtn') as HTMLButtonElement,
    loginBtnText: document.getElementById('mobileLoginBtnText') as HTMLSpanElement,
    logoutBtn: document.getElementById('mobileLogoutBtn') as HTMLButtonElement,
    avatar: document.getElementById('mobileUserAvatar') as HTMLImageElement,
    name: document.getElementById('mobileUserName')!,
    email: document.getElementById('mobileUserEmail')!,
    fallbackAvatar: '/assets/images/mewtwo.png',
  });
</script>
