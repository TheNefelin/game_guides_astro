--- 
import type { Game } from '@/types/game';

interface Props {
  games: Game[];
  totalGames: number;
}

const { games, totalGames } = Astro.props;

const rated = games.filter((g) => g.rating != null);
const average = (rated.reduce((sum, g) => sum + (g.rating as number), 0) / (rated.length * 2 || 1)).toFixed(1);
const genreCount = new Set(games.flatMap((g) => g.genres.map((genre) => genre.id))).size;
const platformCount = new Set(games.flatMap((g) => g.platforms.map((p) => p.id))).size;

const stats = [
  { value: totalGames, label: 'Total de juegos', color: 'text-primary' },
  { value: average, label: 'Valoración promedio', color: 'text-error' },
  { value: genreCount, label: 'Géneros', color: 'text-accent' },
  { value: platformCount, label: 'Plataformas', color: 'text-primary' },
];
---

<section class="max-w-7xl mx-auto px-4 lg:px-8 -mt-16 relative z-20">
  <div class="glass-card rounded-2xl p-8 shadow-[0_0_15px_color-mix(in_srgb,var(--color-primary)_10%,transparent),inset_0_0_15px_color-mix(in_srgb,var(--color-primary)_3%,transparent)]">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {stats.map((s) => (
        <div class="stat-box relative overflow-hidden">
          <div class="font-gaming text-3xl font-bold {s.color}">{s.value}</div>
          <div class="text-base-content/40 text-sm mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>