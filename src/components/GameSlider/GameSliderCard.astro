---
import type { Game } from '@/types/game';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<div class="glass-card rounded-xl p-3 h-44 flex flex-col transition-all cursor-pointer relative overflow-hidden">
  <div class="absolute inset-0 rounded-xl bg-base-200 pointer-events-none"></div>
  <div class="relative z-10 flex-1 flex flex-col justify-between items-center">
    <div class="w-24 h-24 rounded-xl overflow-hidden bg-base-300 ring-2 ring-base-content/5 group-hover:ring-accent/30 transition-all">
      {
        game.cover_url
        ? <img
            src={game.cover_url}
            alt={game.name}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            loading="lazy"
            width="96"
            height="96"/>
        : <div class="w-full h-full flex items-center justify-center text-base-content/20 text-4xl"><i class="fa-solid fa-gamepad"></i></div>
      }
    </div>
    <span class="text-base-content text-xs font-semibold text-center leading-tight">{game.name}</span>
    <span class="text-base-content/40 text-[10px]">{game.genres[0]?.name ?? ''}</span>
  </div>
</div>
