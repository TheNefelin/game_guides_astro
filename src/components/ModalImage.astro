<dialog id="modal-image" class="modal">
  <div class="modal-box p-0 max-w-5xl relative bg-base-100 border border-base-content/10">
    <img
      id="modal-image-src"
      src=""
      alt=""
      class="w-full h-auto object-contain"
    />
    <form method="dialog">
      <button class="absolute top-2 right-2 btn btn-sm btn-circle bg-base-content/10 hover:bg-error/20 text-base-content">
        ✕
      </button>
    </form>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#modal-image');
  const img = document.querySelector<HTMLImageElement>('#modal-image-src');

  if (!modal || !img) throw new Error('ModalImage: elementos no encontrados');

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-modal]');
    if (!trigger) return;

    const url = trigger.getAttribute('data-modal');
    const alt = trigger.getAttribute('data-modal-alt');
    
    if (url) {
      img.src = url;
      img.alt = alt ?? '';
      modal.showModal();
    }
  });
</script>
