---
import type { GameDetail } from '@/types/game';

interface Props {
  game: GameDetail;
}

const { game } = Astro.props;
const guides = game.guides ?? [];
const total = guides.length;
const totalSteps = total + guides.reduce((n, g) => n + (g.adventures?.length ?? 0), 0);
const badgeClass = (i: number) => i % 2 === 0 ? 'border border-pink-400 bg-pink-400/60' : 'border border-warning bg-warning/60';
const stepLabel = (isImportant: boolean, isOptional: boolean) => isImportant ? 'Decisión importante' : isOptional ? 'Paso opcional' : 'Paso';
---

<div class="glass-card rounded-xl p-2 sm:p-8" data-game-id={game.id}>
  <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
    <div>
      <h2 class="font-gaming text-2xl font-bold text-base-content">
        <i class="fa-solid fa-timeline text-primary mr-3"></i>Guía Time Line
      </h2>
      <p class="text-base-content/40 text-sm mt-1">
        Sigue la aventura paso a paso — {total} {total === 1 ? 'entrada' : 'entradas'}
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-base-content/40 text-xs">
        <i class="fa-regular fa-circle-check text-primary mr-1"></i> <span data-progress-count>0/{totalSteps}</span>
      </span>
      <button class="btn btn-ghost btn-xs text-base-content/50 hover:text-primary" data-close-all>
        <i class="fa-solid fa-angle-up mr-1"></i> Cerrar todos
      </button>
      <button class="btn btn-ghost btn-xs text-base-content/50 hover:text-primary" data-reset>
        <i class="fa-solid fa-rotate-right mr-1"></i> Reset
      </button>
    </div>
  </div>

  {
    total === 0 ? (
      <div class="text-center py-12 text-base-content/30">
        <i class="fa-solid fa-timeline text-4xl mb-4 block"></i>
        <p>Las entradas de la guía se cargarán próximamente.</p>
      </div>
    ) : (
      guides.map((guide, gi) => (
        <div id={`G-${guide.id}`} class="collapse collapse-arrow bg-base-100/80 border border-base-content/5 mb-3 rounded-xl">
          <input type="checkbox" />
          <div class="collapse-title text-base md:text-lg font-medium text-base-content flex items-center gap-3 rounded-xl" data-guide-title={guide.id}>
            <span class={`w-7 h-7 rounded-full ${badgeClass(gi)} text-xs font-bold flex items-center justify-center shrink-0`}>
              {gi + 1}
            </span>
            {guide.title}
          </div>
          <div class="collapse-content">
            <header>
              <div class="flex items-center gap-2 my-4 p-3 rounded-lg bg-base-content/5">
                <div class="tooltip tooltip-top tooltip-start" data-tip="Debes Iniciar Sesion">
                  <input type="checkbox" class="checkbox checkbox-accent checkbox-xs border-2" data-guide-id={guide.id} />
                </div>
                <span class="text-base-content/60 text-sm">Marcar como completado</span>
              </div>
              <p class="whitespace-pre-wrap font-extralight my-4">{guide.summary}</p>
            </header>
            <div class="space-y-4">
              {
                guide.adventures.map((adv) => (
                  <div class={adv.is_important
                    ? 'p-3 rounded-lg bg-error/80 border-l-2 border-error text-white'
                    : 'p-3 rounded-lg bg-base-content/2 border-l-2 border-primary/30 text-base-content/70'}>
                    <div class="flex items-center gap-2">
                      <div class="tooltip tooltip-top tooltip-start" data-tip="Debes Iniciar Sesion">
                        <input type="checkbox" class="checkbox checkbox-accent checkbox-xs border-2" data-adventure-id={adv.id} />
                      </div>
                      <span class="text-xs font-bold uppercase">{stepLabel(adv.is_important, adv.is_optional)}</span>
                    </div>
                    <p class="whitespace-pre-wrap text-sm py-4">{adv.description}</p>
                    <section class="grid grid-cols-1 md:grid-cols-2 gap-2">
                      {
                        adv.images.map((img) => (
                          <img
                            src={img.image_url}
                            alt={img.alt_text ?? guide.title}
                            data-modal={img.image_url}
                            data-modal-alt={img.alt_text ?? ''}
                            class="w-full max-w-lg rounded-lg shadow-md cursor-pointer"
                            loading="lazy"
                          />
                        ))
                      }
                    </section>
                  </div>
                ))
              }
            </div>
            <div class="flex justify-end mt-4 pt-3 border-t border-base-content/5">
              <a href={`#G-${guide.id}`} class="text-base-content/40 hover:text-primary text-xs transition-colors flex items-center gap-1">
                <i class="fa-solid fa-arrow-up"></i> Volver arriba
              </a>
            </div>
          </div>
        </div>
      ))
    )
  }
</div>

<!-- Reset progress confirmation modal -->
<dialog id="reset-modal" class="modal">
  <div class="modal-box bg-base-100 text-base-content border border-error max-w-sm p-6">
    <form method="dialog">
      <button class="absolute top-3 right-3 btn btn-sm btn-circle bg-base-content/10 hover:bg-error/20 text-base-content">
        ✕
      </button>
    </form>
    <div class="flex items-start gap-3">
      <i class="fa-solid fa-triangle-exclamation text-error text-2xl mt-0.5"></i>
      <div>
        <h3 class="font-gaming text-lg font-bold text-base-content">¿Reiniciar progreso?</h3>
        <p class="text-base-content/60 text-sm mt-1">
          Se desmarcarán todas las guías y pasos de este juego. Esta acción no se puede deshacer.
        </p>
      </div>
    </div>
    <div class="flex justify-end gap-2 mt-6">
      <button class="btn btn-ghost btn-sm text-base-content/60" data-reset-cancel>Cancelar</button>
      <button class="btn btn-error btn-sm text-white" data-reset-confirm>Reiniciar</button>
    </div>
  </div>
</dialog>


<script>
  import { apiFetch, isAuthenticated } from '@/lib/auth';
  import { showToast } from '@/lib/toastTrigger';
  import type { GuideCheck, AdventureCheck, HttpMethod, RequestBody, UserProgressResponse } from '@/types/progress';

  const containerComponent = document.querySelector<HTMLElement>('[data-game-id]');
  const gameId = Number(containerComponent?.getAttribute('data-game-id'));

  const allTooltips = containerComponent?.querySelectorAll<HTMLElement>('[data-tip]') ?? [];
  const allGuides = containerComponent?.querySelectorAll<HTMLInputElement>('[data-guide-id]') ?? [];
  const allAdventure = containerComponent?.querySelectorAll<HTMLInputElement>('[data-adventure-id]') ?? [];
  const collapseToggles = containerComponent?.querySelectorAll<HTMLInputElement>('.collapse > input[type="checkbox"]') ?? [];
  const progressCount = containerComponent?.querySelector<HTMLElement>('[data-progress-count]');
  const closeAllBtn = containerComponent?.querySelector<HTMLElement>('[data-close-all]');
  const resetBtn = containerComponent?.querySelector<HTMLElement>('[data-reset]');
  const resetModal = document.querySelector<HTMLDialogElement>('#reset-modal');
  const resetCancel = resetModal?.querySelector<HTMLElement>('[data-reset-cancel]');
  const resetConfirm = resetModal?.querySelector<HTMLElement>('[data-reset-confirm]');

  const totalSteps = allGuides.length + allAdventure.length;

  function updateProgressCount() {
    if (!progressCount) return;
    const done = [...allGuides].filter((cb) => cb.checked).length + [...allAdventure].filter((cb) => cb.checked).length;
    progressCount.textContent = `${done}/${totalSteps}`;
  }

  const guideTitles = new Map<number, HTMLElement>();
  containerComponent?.querySelectorAll<HTMLElement>('[data-guide-title]').forEach((el) => {
    guideTitles.set(Number(el.dataset.guideTitle), el);
  });

  const pending = new Set<HTMLInputElement>();

  containerComponent?.addEventListener('change', async (e) => {
    if (!(e.target instanceof HTMLInputElement)) return;
    if (e.target.matches('[data-guide-id]')) await toggleGuide(e.target);
    else if (e.target.matches('[data-adventure-id]')) await toggleAdventure(e.target);
  });

  closeAllBtn?.addEventListener('click', () => {
    collapseToggles.forEach((cb) => { cb.checked = false; });
  });

  resetBtn?.addEventListener('click', () => {
    resetModal?.showModal();
  });

  resetCancel?.addEventListener('click', () => {
    resetModal?.close();
  });

  resetConfirm?.addEventListener('click', async () => {
    if (resetConfirm.dataset.busy) return;
    resetConfirm.dataset.busy = 'true';
    resetConfirm.classList.add('btn-disabled');
    try {
      const result = await fetchProgress<unknown>('user-progress/by-game/' + gameId, 'DELETE');
      resetModal?.close();
      if (result === null) return;
      allGuides.forEach((cb) => { cb.checked = false; syncGuideTitle(cb); });
      allAdventure.forEach((cb) => { cb.checked = false; });
      updateProgressCount();
      showToast('Progreso reiniciado', 'success');
    } finally {
      delete resetConfirm.dataset.busy;
      resetConfirm.classList.remove('btn-disabled');
    }
  });

  function syncGuideTitle(cb: HTMLInputElement) {
    guideTitles.get(Number(cb.dataset.guideId))?.classList.toggle('bg-accent/50', cb.checked);
  }

  async function toggleGuide(cb: HTMLInputElement) {
    if (pending.has(cb)) return;
    pending.add(cb);
    const guideId = Number(cb.dataset.guideId);
    const checked = cb.checked;
    const body: GuideCheck = { guide_id: guideId };
    try {
      const result = await fetchProgress(
        checked ? 'user-guides' : `user-guides/${guideId}`,
        checked ? 'POST' : 'DELETE',
        checked ? body : undefined
      );
      if (result === null) cb.checked = !checked;
      else showToast('Guía modificada correctamente', 'success');
    } finally {
      pending.delete(cb);
      syncGuideTitle(cb);
      updateProgressCount();
    }
  }

  async function toggleAdventure(cb: HTMLInputElement) {
    if (pending.has(cb)) return;
    pending.add(cb);
    const adventureId = Number(cb.dataset.adventureId);
    const checked = cb.checked;
    const body: AdventureCheck = { adventure_id: adventureId };
    try {
      const result = await fetchProgress(
        checked ? 'user-adventures' : `user-adventures/${adventureId}`,
        checked ? 'POST' : 'DELETE',
        checked ? body : undefined
      );
      if (result === null) cb.checked = !checked;
      else showToast('Aventura modificada correctamente', 'success');
    } finally {
      pending.delete(cb);
      updateProgressCount();
    }
  }

  async function fetchProgress<T>(path: string, method: HttpMethod = 'GET', body?: RequestBody): Promise<T | null> {
    let res: Response;
    try {
      res = await apiFetch(path, {
        method,
        headers: { 
          ...(body && { 'Content-Type': 'application/json' }),
        },
        body: body ? JSON.stringify(body) : undefined,
      });
    } catch {
      showToast('Error de red, revisa tu conexión', 'error');
      return null;
    }

    if (!res.ok) {
      showToast(`Error al sincronizar progreso (${res.status})`, 'error');
      return null;
    }

    if (res.status === 204) return {} as T;
    return (await res.json()) as T;
  }

  async function getProgress(): Promise<UserProgressResponse | null> {
    if (!isAuthenticated()) return { guides: [], adventures: [] };
    return await fetchProgress<UserProgressResponse>(`user-progress/by-game/${gameId}`);
  }

  async function loadProgress() {
    const progress = await getProgress();

    const guideMap = new Map((progress?.guides ?? []).map((g) => [g.guide_id, g.is_completed]));
    allGuides.forEach((cb) => {
      cb.checked = guideMap.get(Number(cb.dataset.guideId)) === true;
      syncGuideTitle(cb);
    });

    const adventureMap = new Map((progress?.adventures ?? []).map((a) => [a.adventure_id, a.is_completed]));
    allAdventure.forEach((cb) => {
      cb.checked = adventureMap.get(Number(cb.dataset.adventureId)) === true;
    });

    updateProgressCount();
  }

  // Se entera del logout (authchange) y actualiza la página sin recargar
  window.addEventListener('authchange', onAuthChange);

  async function onAuthChange() {
    await loadProgress();

    const authed = isAuthenticated();
    allGuides.forEach((cb) => { cb.disabled = !authed; });
    allAdventure.forEach((cb) => { cb.disabled = !authed; });
    allTooltips.forEach((t) => {
      authed ? t.removeAttribute('data-tip') : t.setAttribute('data-tip', 'Debes Iniciar Sesion');
    });
    resetBtn?.classList.toggle('hidden', !authed);
  }

  onAuthChange();
</script>
