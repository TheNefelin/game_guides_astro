---
import type { Screenshot, Map, GameDetail } from '@/types/game';
import TabButton from '@/components/Game/TabButton.astro';
import ScreenshotGallery from '@/components/Game/ScreenshotGallery.astro';
import MapsGallery from '@/components/Game/MapsGallery.astro';
import SourcesList from '@/components/Game/SourcesList.astro';
import CharactersList from '@/components/Game/CharactersList.astro';
import TimeLine from '@/components/Game/TimeLine.astro';

interface Props {
  game: GameDetail;
  screenshots: Screenshot[];
  maps: Map[];
}

const { game, screenshots, maps } = Astro.props;

const tabs = [
  { tabId: 'guide', icon: 'fa-solid fa-book-open mr-2', label: 'Juego' },
  { tabId: 'timeline', icon: 'fa-solid fa-timeline mr-2', label: 'Guía Time Line' },
  { tabId: 'maps', icon: 'fa-solid fa-map mr-2', label: 'Mapas / Equipo' },
  { tabId: 'characters', icon: 'fa-solid fa-users mr-2', label: 'Personajes' },
  { tabId: 'sources', icon: 'fa-solid fa-link mr-2', label: 'Fuentes' },
]
---

<!-- ═══════════ TAB BUTTONS ═══════════ -->
<section class="max-w-7xl mx-auto px-4 lg:px-8 py-6">
  <div class="glass-card rounded-xl p-2 flex flex-wrap gap-2">
    { tabs.map((t, i) => <TabButton {...t} active={i === 0} />) }
  </div>
</section>

<!-- ═══════════ TAB CONTENT PANELS ═══════════ -->
<section class="max-w-7xl mx-auto px-4 lg:px-8 pb-24">

  <div id="tab-guide">
    <div class="glass-card rounded-xl p-6 md:p-8 mb-8">
      <p class="text-base-content/60 leading-relaxed text-lg indent-8">
        {game.description ?? 'Sin descripción disponible.'}
      </p>
    </div>
    <ScreenshotGallery screenshots={screenshots} />
  </div>

  <div id="tab-timeline" class="hidden">
    <TimeLine game={game} />
  </div>

  <div id="tab-maps" class="hidden">
    <div class="glass-card rounded-xl p-2 md:p-8">
      <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
        <div>
          <h2 class="font-gaming text-2xl font-bold text-base-content">
            <i class="fa-solid fa-map text-primary mr-3"></i>Mapas
          </h2>
          <p class="text-base-content/40 text-sm mt-1">Mapas y zonas del juego</p>
        </div>
      </div>
      <MapsGallery maps={maps} />
    </div>
  </div>

  <div id="tab-characters" class="hidden">
    <CharactersList characters={game.characters} />
  </div>

  <div id="tab-sources" class="hidden">
    <div class="glass-card rounded-xl p-6 md:p-8">
      <h2 class="font-gaming text-2xl font-bold text-base-content mb-6">
        <i class="fa-solid fa-link text-primary mr-3"></i>Fuentes y Referencias
      </h2>
      <SourcesList sources={game.sources} />
    </div>
  </div>

</section>

<script>
  const ACTIVE = ['text-primary', 'bg-primary/15', 'border-primary/30'] as const;
  const INACTIVE = ['text-base-content/50', 'border-transparent'] as const;

  const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[id^="tab-"]'));

  for (const btn of tabBtns) {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-tab');

      for (const b of tabBtns) {
        b.classList.remove(...ACTIVE);
        b.classList.add(...INACTIVE);
      }

      for (const panel of panels) panel.classList.add('hidden');
      btn.classList.remove(...INACTIVE);
      btn.classList.add(...ACTIVE);

      const panel = id ? document.getElementById('tab-' + id) : null;
      if (panel) panel.classList.remove('hidden');
    });
  }
</script>