---
import type { Game } from '@/types/game';
import TagPill from '@/components/TagPill.astro';
import Stars from '@/components/Stars.astro';

interface Props {
  game: Game;
  bgImage: string;
}

const { game, bgImage } = Astro.props;
---

<section class="relative min-h-[50vh] md:min-h-[60vh] flex items-end pt-16 bg-cover bg-center bg-fixed" style={`background-image: url('${bgImage}')`}>
  <div class="absolute inset-0 bg-linear-to-t from-base-100 via-base-100/20 to-transparent"></div>
  <div class="max-w-7xl mx-auto px-4 lg:px-8 w-full relative z-10 pb-8 md:pb-12">
    <div class="flex flex-col md:flex-row md:items-end gap-6">
      <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl overflow-hidden shadow-2xl border-2 border-primary/20 shrink-0 bg-base-300">
        {
          game.cover_url
            ? <img src={game.cover_url} alt={game.name} class="w-full h-full object-cover" />
            : <div class="w-full h-full flex items-center justify-center text-base-content/20 text-4xl"><i class="fa-solid fa-gamepad"></i></div>
        }
      </div>
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          {game.platforms.map(p => <TagPill text={p.name} />)}
          {game.genres.map(g => <TagPill text={g.name} />)}
        </div>
        <h1 class="font-gaming text-3xl md:text-5xl font-black text-base-content neon-text">{game.name}</h1>
        <div class="flex items-center gap-4 mt-2 text-base-content/50 text-sm">
          {game.release_year && <span><i class="fa-solid fa-calendar mr-1"></i> {game.release_year}</span>}
          <Stars rating={game.rating} />
        </div>
      </div>
    </div>
  </div>
</section>