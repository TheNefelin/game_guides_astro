---
import type { Screenshot } from '@/types/game';

interface Props {
  screenshots: Screenshot[];
}
const { screenshots } = Astro.props;
---

{
  screenshots.length > 0 ? (
    <div class="grid md:grid-cols-2 gap-6">
      {screenshots.map((s) => (
        <div
          data-url={s.image_url}
          data-alt={s.alt_text ?? ''}
          class="rounded-xl overflow-hidden shadow-xl border border-white/5 cursor-pointer"
        >
          <img
            src={s.image_url}
            alt={s.alt_text ?? ''}
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  ) : (
    <div class="text-center py-12 text-base-content/30">
      <i class="fa-solid fa-image text-4xl mb-4 block"></i>
      <p>No hay capturas disponibles.</p>
    </div>
  )
}

<script>
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-url]');
    if (!el) return;
    const url = el.getAttribute('data-url');
    const alt = el.getAttribute('data-alt');
    if (url) {
      const w = window as Window & { modalImageOpen: (url: string, alt?: string) => void };
      w.modalImageOpen(url, alt ?? undefined);
    }
  });
</script>

