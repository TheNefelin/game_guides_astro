---
import "../assets/app.css";
import "@fortawesome/fontawesome-free/css/all.min.css";
import Navbar from '@/components/Navbar/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';
import ModalImage from "@/components/ModalImage.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Game Guides - Guías de Videojuegos',
  description = 'Guías de videojuegos creadas por un gamer para gamers. Nunca más pierdas el hilo de tu partida.',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body class="flex flex-col min-h-screen">
		<Navbar />

		<main class="flex-1 animate-fade-in">
			<slot />
		</main>

		<Footer />

		<ScrollToTop />

		<ModalImage />

		<div id="toast-container" class="toast toast-end z-10 hidden"></div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
  import { clearExpiredSession } from '@/lib/auth';

  clearExpiredSession();

  const main = document.querySelector('main');
  const FADE_OUT_MS = 600;
  let transitioning = false;

  function isInternalNavigation(href: string | null): boolean {
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) {
      return false;
    }
    try {
      return new URL(href, window.location.origin).origin === window.location.origin;
    } catch {
      return false;
    }
  }

  document.addEventListener('click', (e) => {
    if (transitioning) {
      e.preventDefault();
      return;
    }

    const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
    if (!anchor) return;

    const href = anchor.getAttribute('href');
    if (!isInternalNavigation(href)) return;
    if (anchor.target && anchor.target !== '_self') return;
    if (anchor.hasAttribute('download')) return;
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

    e.preventDefault();
    transitioning = true;

    main?.classList.remove('animate-fade-in');
    main?.classList.add('animate-fade-out');

    window.setTimeout(() => {
      window.location.href = anchor.href;
    }, FADE_OUT_MS);
  });

  // Al volver atrás/adelante con las flechas del navegador (bfcache),
  // el <main> se restaura con la clase animate-fade-out (opacity 0) y el
  // script no se re-ejecuta. pageshow con persisted=true restaura la visibilidad.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      main?.classList.remove('animate-fade-out');
      main?.classList.add('animate-fade-in');
      transitioning = false;
    }
  });
</script>
